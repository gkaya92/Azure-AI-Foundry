# Azure AI Foundry Project Configuration
# Copy this file to .env and fill in your actual values

# Required: Azure Subscription Information
AZURE_SUBSCRIPTION_ID=<YOUR_AZURE_SUBSCRIPTION_ID>
AZURE_RESOURCE_GROUP_NAME=<YOUR_AZURE_RESOURCE_GROUP_NAME>
AZURE_PROJECT_NAME=<YOUR_AZURE_AI_FOUNDRY_PROJECT_NAME>

# Required: Azure AI Foundry Project Endpoint
# Format: https://<YOUR_RESOURCE_NAME>.services.ai.azure.com/api/projects/<YOUR_PROJECT_NAME>
PROJECT_ENDPOINT=https://<YOUR_RESOURCE_NAME>.services.ai.azure.com/api/projects/<YOUR_PROJECT_NAME>

# Required: Model Deployment Name (default: gpt-4o)
AGENT_MODEL_DEPLOYMENT_NAME=gpt-4o

# Optional: Bing Grounding Connection Name (for web search capabilities)
# BING_CONNECTION_NAME=<YOUR_BING_CONNECTION_NAME>

# Optional: Environment setting (local or container)
ENVIRONMENT=local

# Optional: Flask server configuration
PORT=5000
